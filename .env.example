SITE_NAME=ClipLoad
SITE_URL=https://yourdomain.com
CONTACT_EMAIL=contact@yourdomain.com

# Leave ADSENSE_CLIENT empty until approved: no ad markup is rendered without it.
ADSENSE_CLIENT=
ADSENSE_SLOT_TOP=
ADSENSE_SLOT_RESULT=
ADSENSE_SLOT_BOTTOM=

MAX_DURATION_SECONDS=10800
MAX_FILESIZE_MB=2048
MAX_CONCURRENT_JOBS=4
MAX_QUEUED_JOBS=40
JOB_TTL_SECONDS=900
RATE_LIMIT_PER_MINUTE=20
TRUST_PROXY_HEADERS=true

# Optional: needed if YouTube/Instagram start blocking your server's IP.
YTDLP_COOKIES_FILE=
YTDLP_PROXY=
